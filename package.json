{
  "name": "emhub",
  "private": true,
  "version": "0.0.1",
  "description": "Employee Onboarding Hub — Supabase + React",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "format": "npm run format --prefix frontend",
    "test": "npm run test --prefix frontend && node --test infra/tests/pipeline-config.test.mjs && node --test infra/cloudflare/tests/cloudflare-config.test.mjs && node --test infra/tests/schema-config.test.mjs",
    "test:schema": "node --test infra/tests/schema-config.test.mjs",
    "test:schema:integration": "./infra/scripts/schema-migrate-test.sh",
    "test:watch": "npm run test:watch --prefix frontend",
    "test:integration": "./infra/scripts/integration-test.sh"
  },
  "devDependencies": {
    "vitest": "^2.1.4"
  }
}

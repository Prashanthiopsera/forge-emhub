# Dev environment — populated by CI from the secret vault on every deploy.
# Local devs copy this to `.env.dev` and fill in values from `supabase status` after `supabase start`.
# NEVER commit a real .env.dev — it is in .gitignore.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# CI-only — never on developer machines
SUPABASE_ACCESS_TOKEN=

# Staging environment — populated by CI from the secret vault on every deploy.
# NEVER commit a real .env.staging — it is in .gitignore.

SUPABASE_URL=https://<staging-project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=postgres://postgres:<password>@db.<staging-project-ref>.supabase.co:5432/postgres

SUPABASE_ACCESS_TOKEN=
